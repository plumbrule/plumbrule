{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plumbrule.dev/schema/topic.schema.json",
  "title": "Plumbrule 主题文件",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "title", "summary", "status", "reviewed_on", "next_review", "overview", "rules", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{2}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "description": "一两句话：这个主题管什么" },
    "status": { "enum": ["draft", "reviewed"] },
    "reviewed_on": { "type": "string", "format": "date" },
    "next_review": { "type": "string", "format": "date" },
    "legal_notice": { "type": "boolean", "description": "页面是否显示「不构成法律意见」" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includes": { "type": "array", "items": { "type": "string" } },
        "excludes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "see"],
            "properties": {
              "what": { "type": "string" },
              "see": { "type": "string", "pattern": "^[0-9]{2}(-[0-9]{2})?$" }
            }
          }
        }
      }
    },
    "overview": { "type": "string", "description": "Markdown：一页结论" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level", "check", "how", "applies", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1, "description": "一句话规则，祈使句" },
          "level": { "enum": ["hard", "soft"] },
          "check": { "enum": ["auto", "semi", "manual"] },
          "how": { "type": "string", "minLength": 1, "description": "怎么检查：工具、命令或审查点" },
          "applies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "why": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "description": "Markdown：细则、例子、例外" },
          "ref_value": { "type": "string", "description": "规则里的数字是参考值时，写明理由" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]{2,3}$" } },
          "see": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "pick"],
        "properties": {
          "category": { "type": "string" },
          "pick": { "type": "string", "description": "默认推荐" },
          "when": { "type": "string", "description": "什么情况下适用" },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "when"],
              "properties": { "name": { "type": "string" }, "when": { "type": "string" } }
            }
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "why"],
              "properties": { "name": { "type": "string" }, "why": { "type": "string" } }
            }
          },
          "license": { "type": "string" },
          "notes": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]{2,3}$" } }
        }
      }
    },
    "antipatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bad", "instead"],
        "properties": { "bad": { "type": "string" }, "instead": { "type": "string" } }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "kind", "checked"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{2,3}$" },
          "title": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "publisher": { "type": "string" },
          "date": { "type": ["string", "null"], "description": "发布日期；不详写 null" },
          "kind": { "enum": ["standard", "official", "community", "case"] },
          "checked": { "type": "string", "format": "date", "description": "核实日期" }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "description": "待核实、待补调研的事项；发布时显示为「待确认」",
      "items": { "type": "string" }
    }
  }
}
