---
// 页脚：版本、授权和法律提示。
import { config } from '../../tools/lib.ts';
import { getLang, strings } from '../lib/site.ts';

const lang = getLang(Astro.url.pathname);
const s = strings[lang];
const ccUrl = lang === 'en' ? 'https://creativecommons.org/licenses/by/4.0/' : 'https://creativecommons.org/licenses/by/4.0/deed.zh-hans';
---
<footer class="pr-footer">
  <p>{lang === 'en' ? 'Plumbrule' : '准绳'} {config.version} · {s.footerLicense} <a href={ccUrl}>{s.footerLicenseLink}</a>{s.footerLicenseAfter} · <a href={config.repoUrl}>GitHub</a></p>
  <p>{s.footerLegal}</p>
</footer>
<style>
  .pr-footer { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--sl-color-hairline); font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .pr-footer p { margin: 0.25rem 0; }
</style>
