---
// 按分组列出全部 32 个主题；还没整理完的主题标「整理中」，不给链接。
import { getLang, getSite, topicHref } from '../lib/site.ts';

const lang = getLang(Astro.url.pathname);
const site = getSite(lang);
const todo = lang === 'en' ? 'In progress' : '整理中';
---
<div class="tgrid not-content">
  {site.groups.map((g) => (
    <div class="tgroup">
      <h3>{g.name}</h3>
      <ul>
        {g.ids.map((id) => {
          const href = topicHref(id, lang);
          const name = site.topicNames[id].名称;
          return (
            <li>
              {href ? <a href={href}><span class="n">{id}</span> {name}</a> : <span class="todo"><span class="n">{id}</span> {name} <span class="pr-chip">{todo}</span></span>}
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>
<style>
  .tgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1.75rem 2rem; }
  h3 { font-size: 0.875rem; font-weight: 600; color: var(--sl-color-gray-3); margin: 0 0 0.5rem; letter-spacing: 0.02em; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  a { color: var(--sl-color-white); text-decoration: none; display: block; padding: 0.25rem 0; }
  a:hover { color: var(--sl-color-accent); }
  .todo { color: var(--sl-color-gray-3); display: block; padding: 0.25rem 0; }
  .n { font-family: var(--sl-font-mono); color: var(--sl-color-gray-3); font-size: 0.875rem; margin-inline-end: 0.25rem; }
</style>
